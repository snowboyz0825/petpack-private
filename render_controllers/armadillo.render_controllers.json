{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.armadillo": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "q.is_name_any('Magmadillo§U§A') ? texture.magma_armadillo:(q.is_name_any('Nautidillo§t§a§g','Armadillus§t§a§g') ? texture.armadillo_nautilus:(q.is_name_any('Frosty§t§a§g') ? texture.frosty:(query.is_baby ? Texture.baby : Texture.default)))"
      ],
      "part_visibility": [
        {
          "body": "!variable.use_rolled_up_model"
        },
        {
          "tail": "!variable.use_rolled_up_model"
        },
        {
          "left_hind_leg": "!variable.use_rolled_up_model"
        },
        {
          "right_hind_leg": "!variable.use_rolled_up_model"
        },
        {
          "body_rolled_up": "variable.use_rolled_up_model"
        }
      ]
    }
  }
}