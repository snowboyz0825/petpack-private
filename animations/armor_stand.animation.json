		"animation.armor_stand.painting_offset": {
			"loop": true,
			"bones": {
				"root_painting": {
					"position": [
						"(v.armor_stand.pose_index==2 || v.armor_stand.pose_index==4 || v.armor_stand.pose_index==6 || v.armor_stand.pose_index==9 ? -16:(v.armor_stand.pose_index==3 || v.armor_stand.pose_index==5 || v.armor_stand.pose_index==8 || v.armor_stand.pose_index==11 ? 16))",
						"(v.armor_stand.pose_index==1 || v.armor_stand.pose_index==2 || v.armor_stand.pose_index==3 ? -16:(v.armor_stand.pose_index==6 || v.armor_stand.pose_index==7 || v.armor_stand.pose_index==8 ? 16:(v.armor_stand.pose_index==9 || v.armor_stand.pose_index==10 || v.armor_stand.pose_index==11 ? 32:(v.armor_stand.pose_index==12 ? 48))))",
						0
					]
				}
			}
		},
		"animation.armor_stand.painting_round_N": {
			"loop": true,
			"bones": {
				"root_painting": {
					"position": [
						"(math.mod(q.position(0),1)*-16)+8+(q.position(0)<0 ? -16:0)",
						"math.mod(q.position(1),1)*-16",
						"(math.mod(q.position(2),1)*16)+8+(q.position(2)>0 ? -16) "
					]
				}
			}
		},
